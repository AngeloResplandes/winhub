        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva versión no tiene un WinHub.zip con un SHA-256 que se pueda verificar."
          }
        }
      }
    },
    "Abre os programas do próprio Wine (configuração, registro, painel de controle…) nesta garrafa." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Wine's own programs (configuration, registry, control panel…) in this bottle."
