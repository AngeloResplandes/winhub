    "A Steam instala o jogo se ainda não estiver instalado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam installs the game if it is not installed yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam instala el juego si aún no está instalado."
          }
        }
      }
    },
    "A Steam já está aberta na garrafa “%@”. Duas Steam ao mesmo tempo podem desinstalar jogos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam is already open in the bottle “%@”. Two Steam instances at once can uninstall games."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ya está abierto en la botella “%@”. Dos instancias de Steam a la vez pueden desinstalar juegos."
          }
        }
      }
    },
    "A garrafa deste atalho não existe mais." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This shortcut's bottle no longer exists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La botella de este acceso directo ya no existe."
          }
        }
      }
    },
    "A garrafa “%@” está em uso por outro WinHub (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bottle “%1$@” is in use by another WinHub (%2$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La botella “%1$@” está en uso por otro WinHub (%2$@)."
