    },
    "Este Mac precisa do Rosetta 2, da Apple, para rodar o Wine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac needs Apple's Rosetta 2 to run Wine."
          }
        }
      }
    },
    "Este Mac precisa do Rosetta 2. Instale com: softwareupdate --install-rosetta --agree-to-license" : {
