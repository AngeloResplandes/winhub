    "Esta opção só muda com a garrafa encerrada. Salve o que estiver aberto antes de continuar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This option only changes with the bottle closed. Save your open work before continuing."
          }
