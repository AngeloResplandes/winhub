    "A Steam instala o jogo se ainda não estiver instalado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam installs the game if it is not installed yet."
          }
        }
      }
    },
    "A Steam já está aberta na garrafa “%@”. Duas Steam ao mesmo tempo podem desinstalar jogos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam is already open in the bottle “%@”. Two Steam instances at once can uninstall games."
